# WorkHub process
WORKHUB_DATA_DIR=~/.workhub
WORKHUB_HOST=127.0.0.1
WORKHUB_PORT=8000
WORKHUB_LOG_LEVEL=INFO
WORKHUB_ALLOWED_ORIGINS=http://127.0.0.1:5173

# One-time administrator bootstrap. Replace before first startup.
WORKHUB_BOOTSTRAP_ADMIN_USERNAME=admin
WORKHUB_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
WORKHUB_SESSION_SECRET=change-me-random-session-secret

# Initial OpenAI-compatible provider settings. Later changes are stored in app.db.
WORKHUB_CHAT_BASE_URL=https://api.openai.com/v1
WORKHUB_CHAT_API_KEY=change-me-chat-api-key
WORKHUB_CHAT_MODEL=change-me-chat-model
WORKHUB_EMBEDDING_BASE_URL=https://api.openai.com/v1
WORKHUB_EMBEDDING_API_KEY=change-me-embedding-api-key
WORKHUB_EMBEDDING_MODEL=change-me-embedding-model

# Initial Feishu application settings. Later changes are stored in app.db.
WORKHUB_FEISHU_APP_ID=change-me-feishu-app-id
WORKHUB_FEISHU_APP_SECRET=change-me-feishu-app-secret

# Local Mock OA connection. Both shared-secret values below must be identical.
WORKHUB_MOCK_OA_MCP_URL=http://127.0.0.1:8001/mcp
WORKHUB_MOCK_OA_SHARED_SECRET=change-me-workhub-mock-oa-shared-secret

# Optional Langfuse observability. Leave blank to use local logs only.
WORKHUB_LANGFUSE_BASE_URL=
WORKHUB_LANGFUSE_PUBLIC_KEY=
WORKHUB_LANGFUSE_SECRET_KEY=

# Mock OA process
MOCK_OA_DATA_DIR=~/.workhub-mock-oa
MOCK_OA_HOST=127.0.0.1
MOCK_OA_PORT=8001
MOCK_OA_ADMIN_TOKEN=change-me-mock-oa-admin-token
MOCK_OA_WORKHUB_SHARED_SECRET=change-me-workhub-mock-oa-shared-secret
